# ============================================
# Kawalis China — Sourcing MVP Environment
# انسخ هذا الملف إلى .env.local وعبّئ القيم
# ============================================

# --- Notion (إلزامي) ---
# مفتاح التكامل من https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرفات قواعد البيانات (انظر NOTION_SETUP.md لطريقة الحصول عليها)
NOTION_REQUESTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_SUPPLIERS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_QUOTES_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_COMMUNICATIONS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp (إلزامي للأزرار) ---
# رقم واتساب كواليس الصين بالصيغة الدولية بدون + (مثال: 9665XXXXXXXX)
WHATSAPP_NUMBER=9665XXXXXXXX
# نفس الرقم لكن متاح للواجهة (نفس القيمة)
NEXT_PUBLIC_WHATSAPP_NUMBER=9665XXXXXXXX

# --- رفع الملفات ---
# نستخدم Netlify Blobs: يعمل تلقائياً على Netlify بدون أي مفاتيح.
# في التطوير المحلي خارج Netlify يكون الرفع معطلاً برسالة ودية والفورم يعمل بدون صور.
